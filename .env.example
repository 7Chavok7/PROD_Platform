# ============================================
#  PRODPLATFORM — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
#  Скопируй этот файл в .env и заполни своими данными
#  .env НЕ ДОЛЖЕН ПОПАДАТЬ В GIT!
# ============================================

# ---------- DJANGO ----------
# Секретный ключ Django (обязательно измени!)
# Генерируется командой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='django-insecure-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# Режим отладки (True для разработки, False для продакшна)
DEBUG=True

# Разрешённые хосты (через запятую, без пробелов)
ALLOWED_HOSTS=localhost,127.0.0.1


# ---------- БАЗА ДАННЫХ (PostgreSQL) ----------
DB_NAME=prodplatform
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432


# ---------- REDIS (Кеш и Celery) ----------
# Для локальной разработки
REDIS_URL=redis://localhost:6379/0

# Для продакшна
# REDIS_URL=redis://redis:6379/0


# ---------- EMAIL (Почтовые уведомления) ----------
# Для разработки — письма в консоль
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Для продакшна — реальная SMTP (например, Яндекс)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=your_email@yandex.ru
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=your_email@yandex.ru


# ---------- CELERY (Фоновые задачи) ----------
# Брокер сообщений (использует Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ---------- SENTRY (Мониторинг ошибок) ----------
# DSN-ключ из Sentry (опционально)
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o123456.ingest.sentry.io/1234567


# ---------- DJANGO STORAGES (Хранение файлов) ----------
# Для локальной разработки — файлы хранятся в папке media/
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# Для продакшна — можно использовать S3-совместимое хранилище
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=prodplatform-media
# AWS_S3_REGION_NAME=ru-central1
# AWS_S3_ENDPOINT_URL=https://storage.yandexcloud.net
# AWS_DEFAULT_ACL='public-read'


# ---------- ОТПРАВКА УВЕДОМЛЕНИЙ В TELEGRAM (опционально) ----------
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789


# ---------- ПРОЧЕЕ ----------
# Минимальная версия Python (для проверки)
# PYTHON_VERSION=3.11